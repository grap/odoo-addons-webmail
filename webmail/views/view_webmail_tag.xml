<odoo>

    <record id="view_webmail_tag_search" model="ir.ui.view">
        <field name="model">webmail.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="view_webmail_tag_list" model="ir.ui.view">
        <field name="model">webmail.tag</field>
        <field name="arch" type="xml">
            <list editable="top" multi_edit="1">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="view_webmail_tag_form" model="ir.ui.view">
        <field name="model">webmail.tag</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_webmail_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="path">webmail-tag</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">webmail.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_webmail_tag"
        name="Tags"
        parent="menu_configuration"
        action="action_webmail_tag"
        sequence="30"
    />

</odoo>
