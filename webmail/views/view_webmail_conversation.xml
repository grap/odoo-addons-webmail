<odoo>

    <record id="view_webmail_conversation_search" model="ir.ui.view">
        <field name="model">webmail.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="subject" />
                <field name="author_ids" />
            </search>
        </field>
    </record>

    <record id="view_webmail_conversation_list" model="ir.ui.view">
        <field name="model">webmail.conversation</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="button_merge"
                    type="object"
                    string="Merge"
                    class="btn-secondary"
                    confirm="Are you sure you want to merge those conversations ?"/>
                </header>
                <field name="author_ids" widget="many2many_avatar_user"/>
                <field name="subject" />
                <field name="first_mail_date" optional="hide"/>
                <field name="last_mail_date" optional="hide"/>
                <field name="last_mail_date_pretty" optional="show"/>
                <field name="mail_qty" />
                <field name="pending_answer" invisible="1" />
                <field name="unread" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_webmail_conversation_form" model="ir.ui.view">
        <field name="model">webmail.conversation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="button_write_answer" data-hotkey="a" string="Write Answer" class="btn-primary" type="object" invisible="pending_answer == True"/>
                    <button name="button_drop_answer" data-hotkey="d" string="drop Answer" class="btn-primary" type="object" invisible="pending_answer == False" confirm="Are you sure to delete your draft answer"/>

                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_mails"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-envelope-o"
                            invisible="mail_qty == 0"
                        >
                            <field name="mail_qty" widget="statinfo" string="Mails" />
                        </button>
                    </div>

                    <group invisible="pending_answer == False">
                        <field name="pending_answer" invisible="1"/>
                        <field name="answer" style="border: 1px solid" nolabel="1"/>
                        <field name="answer_contact_ids" widget="many2many_avatar_user"/>
                    </group>
                    <field name="mail_ids">
                        <kanban class="o_kanban_mobile">
                            <field name="author_contact_id"/>
                            <field name="date"/>
                            <field name="content"/>
                            <templates>
                                <t t-name="card" class="flex-row kanban_mail_full_screen">
                                    <main class="w-100 ps-2 pt-1">
                                        <div>
                                            <field name="author_contact_id" class="kanban_mail_inline_text"/>
                                            <span class="kanban_mail_inline_text_static">wrote on</span>
                                            <field name="date" class="kanban_mail_inline_text"/>
                                        </div>
                                        <hr/>
                                        <div>
                                            <field name="content" widget="html_mail" class="hide_reply_and_author"/>
                                        </div>
                                    </main>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_webmail_conversation" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="path">webmail-conversation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">webmail.conversation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_webmail_conversation"
        name="Conversations"
        parent="menu_root"
        action="action_webmail_conversation"
        sequence="1"
    />

</odoo>
