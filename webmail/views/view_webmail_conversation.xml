<odoo>

    <record id="view_webmail_conversation_search" model="ir.ui.view">
        <field name="model">webmail.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="subject" />
                <field name="author_ids" />
                <field name="tag_ids" />
                <filter string="Authors" name="group_by_author_ids" context="{'group_by': 'author_ids'}"/>
                <filter string="Tags" name="group_by_tag_ids" context="{'group_by': 'tag_ids'}"/>
                <filter string="Subjects" name="group_by_subject" context="{'group_by': 'subject'}"/>
                <filter name="filter_active" string="Active" domain="[('active','=',True)]"/>
            </search>
        </field>
    </record>

    <record id="view_webmail_conversation_list" model="ir.ui.view">
        <field name="model">webmail.conversation</field>
        <field name="arch" type="xml">
            <list decoration-bf="has_been_read == False"
                multi_edit="1"
                decoration-info="pending_answer == True"
                decoration-it="pending_answer == True">
                <header>
                    <button name="button_merge"
                        type="object"
                        string="Merge"
                        class="btn-secondary"
                        confirm="Are you sure you want to merge those conversations ?"/>
                    <button name="button_mark_as_read"
                        type="object"
                        string="Read"
                        class="btn-secondary"/>
                    <button name="button_mark_as_unread"
                        type="object"
                        string="Unread"
                        class="btn-secondary"/>
                    <button name="unlink"
                        type="object"
                        string="Erase (E)"
                        class="btn-warning"
                        data-hotkey="e"
                        context="{'erase_mail': True}"
                        confirm="Are you sure you want to drop the mail(s) on the server ?"/>
                    <button name="action_archive" string="Archive" class="btn-secondary" type="object"/>
                    <button name="action_unarchive" string="Unarchive" class="btn-secondary" type="object"/>
                </header>

                <field name="author_ids" widget="many2many_avatar_user"/>
                <field name="mail_qty" string="" invisible="mail_qty == 1"/>
                <field name="subject"/>
                <field name="last_mail_date_pretty" string="Date"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="first_mail_date" optional="hide"/>
                <field name="last_mail_date" optional="hide"/>
                <field name="has_been_read" optional="hide" widget="boolean_toggle" string="Read"/>
                <field name="active" optional="hide" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_webmail_conversation_form" model="ir.ui.view">
        <field name="model">webmail.conversation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="button_write_answer" data-hotkey="a" string="Write Answer (A)" class="btn-primary" type="object" invisible="pending_answer == True"/>
                    <button name="button_drop_answer" data-hotkey="d" string="Drop Answer (D)" class="btn-warning" type="object" invisible="pending_answer == False" confirm="Are you sure to delete your draft answer"/>
                    <button name="button_send_answer" data-hotkey="a" string="Send Answer (S)" class="btn-primary" type="object" invisible="pending_answer == False"/>
                    <button name="unlink" data-hotkey="e" string="Erase (E)" class="btn-warning" type="object"
                        context="{'erase_mail': True}"
                        confirm="Are you sure you want to drop the mail(s) on the server ?"/>
                    <button name="action_archive" string="Archive" class="btn-secondary" type="object" invisible="not active"/>
                    <button name="action_unarchive" string="Unarchive" class="btn-secondary" type="object" invisible="active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_mails"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-envelope-o"
                            invisible="mail_qty == 0"
                        >
                            <field name="mail_qty" widget="statinfo" string="Mails" />
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group invisible="pending_answer == False">
                        <field name="pending_answer" invisible="1"/>
                        <field name="answer_contact_ids" widget="many2many_avatar_user"/>
                        <field name="answer" style="border: 1px solid" nolabel="1"/>
                    </group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                        <field name="read_me" invisible="1"/>
                    </group>
                    <field name="mail_ids">
                        <kanban class="o_kanban_mobile">
                            <field name="author_contact_id"/>
                            <field name="date"/>
                            <field name="body"/>
                            <templates>
                                <t t-name="card" class="flex-row kanban_mail_full_screen">
                                    <main class="w-100 ps-2 pt-1">
                                        <div>
                                            <div class="mail_header_content" style="float:left;">
                                                <field name="counter_text" class="kanban_mail_inline_counter"/>
                                            </div>
                                            <div class="mail_header_content" style="float:left;">
                                                <field name="author_avatar_256" widget="image" class="oe_avatar" options="{'preview_image': 'author_avatar_256', 'size': [50, 50]}"/>
                                            </div>
                                            <div class="mail_header_content">
                                                <field name="author_contact_id" class="kanban_mail_inline kanban_mail_inline_field"/>
                                                <span class="kanban_mail_inline kanban_mail_inline_static">wrote on</span>
                                                <field name="date" class="kanban_mail_inline kanban_mail_inline_field"/>
                                            </div>
                                        </div>
                                        <div>
                                            <field name="body" widget="html_mail" class="hide_reply_and_author"/>
                                        </div>
                                    </main>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_webmail_conversation" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="path">webmail-conversation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">webmail.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False, 'search_default_filter_active': True}</field>
    </record>

    <menuitem
        id="menu_webmail_conversation"
        name="Conversations"
        parent="menu_root"
        action="action_webmail_conversation"
        sequence="1"
    />

</odoo>
