<odoo>

    <record id="view_webmail_conversation_search" model="ir.ui.view">
        <field name="model">webmail.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="subject" />
            </search>
        </field>
    </record>

    <record id="view_webmail_conversation_list" model="ir.ui.view">
        <field name="model">webmail.conversation</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="button_merge"
                    type="object"
                    string="Merge"
                    class="btn-secondary"
                    confirm="Are you sure you want to merge those conversations ?"/>
                </header>
                <field name="subject" />
                <field name="interlocutor_ids" widget="many2many_avatar_user"/>
                <field name="date" optional="hide"/>
                <field name="last_answer_date" optional="hide"/>
                <field name="display_date" optional="show"/>
                <field name="mail_qty" />
            </list>
        </field>
    </record>

    <record id="view_webmail_conversation_form" model="ir.ui.view">
        <field name="model">webmail.conversation</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <group>
                        <field name="mail_ids" nolabel="1">
                            <list>
                                <field name="identifier" optional="hide" />
                                <field name="reply_identifier" optional="hide" />
                                <field name="date" optional="show" />
                                <field name="from_text" optional="show" />
                                <field name="body" widget="html_mail" optional="show" />
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_webmail_conversation" model="ir.actions.act_window">
        <field name="name">Conversations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">webmail.conversation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_webmail_conversation"
        name="Conversations"
        parent="menu_root"
        action="action_webmail_conversation"
        sequence="1"
    />

</odoo>
