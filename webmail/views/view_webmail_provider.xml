<odoo>

    <record id="view_webmail_provider_search" model="ir.ui.view">
        <field name="model">webmail.provider</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="view_webmail_provider_list" model="ir.ui.view">
        <field name="model">webmail.provider</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128', 'size': [30, 30]}"/>
                <field name="name" />
                <field name="imap_url" />
                <field name="imap_port" />
            </list>
        </field>
    </record>

    <record id="action_webmail_provider" model="ir.actions.act_window">
        <field name="name">Providers</field>
        <field name="path">webmail-provider</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">webmail.provider</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="menu_webmail_provider"
        name="Providers"
        parent="menu_configuration"
        action="action_webmail_provider"
        sequence="50"
    />

</odoo>
