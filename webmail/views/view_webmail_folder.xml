<odoo>

    <record id="view_webmail_folder_search" model="ir.ui.view">
        <field name="model">webmail.folder</field>
        <field name="arch" type="xml">
            <search>
                <field name="complete_name" />
                <field name="account_id" />
            </search>
        </field>
    </record>

    <record id="view_webmail_folder_list" model="ir.ui.view">
        <field name="model">webmail.folder</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="button_fetch_mails"
                    type="object"
                    string="Fetch Mails"
                    class="btn-secondary"/>
                </header>
                <field name="complete_name" />
                <field name="parent_id" optional="hide"/>
                <field name="account_id" optional="show"/>
                <field name="mail_qty" />
                <field name="last_fetch_date" />
                <field name="limited_fetch" widget="boolean_toggle" />
                    <button
                    string="Fetch Mails"
                    type="object"
                    name="button_fetch_mails"
                />
            </list>
        </field>
    </record>

    <record id="view_webmail_folder_form" model="ir.ui.view">
        <field name="model">webmail.folder</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        string="Fetch Mails"
                        type="object"
                        name="button_fetch_mails"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_mails"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-envelope-o"
                            invisible="mail_qty == 0"
                        >
                            <field name="mail_qty" widget="statinfo" string="Mails" />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="parent_id" />
                            <field name="technical_name" />
                            <field name="account_id" />
                            <field name="limited_fetch" widget="boolean_toggle" />
                        </group>
                        <group />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_webmail_folder" model="ir.actions.act_window">
        <field name="name">Folders</field>
        <field name="path">webmail-folder</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">webmail.folder</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_webmail_folder"
        name="Folders"
        parent="menu_technical_mail"
        action="action_webmail_folder"
        sequence="100"
    />

</odoo>
