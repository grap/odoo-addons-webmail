<odoo>

    <record id="view_webmail_mail_search" model="ir.ui.view">
        <field name="model">webmail.mail</field>
        <field name="arch" type="xml">
            <search>
                <field name="subject" />
                <field name="author_contact_id" />
                <field name="folder_id" />
            </search>
        </field>
    </record>

    <record id="view_webmail_mail_list" model="ir.ui.view">
        <field name="model">webmail.mail</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="unlink"
                        type="object"
                        string="Erase (E)"
                        class="btn-warning"
                        context="{'erase_mail': True}"
                        />
                </header>
                <field name="identifier" optional="hide" />
                <field name="reply_identifier" optional="hide" />
                <field name="date" />
                <field name="author_contact_id" />
                <field name="to_text" optional="hide" />
                <field name="cc_text" optional="hide" />
                <field name="subject" />
                <field name="origin_mail_id" optional="hide" />
                <field name="folder_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_webmail_mail_form" model="ir.ui.view">
        <field name="model">webmail.mail</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <group>
                        <group>
                            <field name="subject" />
                            <field name="conversation_id" />
                            <field name="folder_id" />
                            <field name="origin_mail_id" />
                            <field name="author_contact_id" />
                        </group>
                        <group>
                            <field name="date" />
                            <field name="original_from_text" />
                            <field name="from_text" />
                            <field name="to_text" />
                            <field name="cc_text" />
                        </group>
                    </group>
                    <notebook>
                        <page string="body">
                            <field name="body" widget="html_mail" />
                        </page>
                        <page string="data">
                            <field name="data" />
                        </page>
                        <page string="Technical fields">
                            <group>
                                <field name="identifier" />
                                <field name="reply_identifier" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_webmail_mail_kanban" model="ir.ui.view">
        <field name="model">webmail.mail</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="author_contact_id"/>
                <field name="date"/>
                <field name="body"/>
                <templates>
                    <t t-name="card" class="flex-row kanban_mail_full_screen">
                        <main class="w-100 ps-2 pt-1">
                            <div>
                                <field name="author_contact_id"/>
                                <field name="date" />
                            </div>
                            <hr/>
                            <div>
                                <field name="body" widget="html_mail" class="hide_reply_and_author"/>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_webmail_mail" model="ir.actions.act_window">
        <field name="name">Mails</field>
        <field name="path">webmail-mail</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">webmail.mail</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <menuitem
        id="menu_webmail_mail"
        name="Mails"
        parent="menu_technical_mail"
        action="action_webmail_mail"
        sequence="30"
    />

</odoo>
